# --- Frontend (se embeben en el bundle, solo claves públicas) ---
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# Dominio público del bucket R2. Puede ser el r2.dev de desarrollo o un
# dominio propio conectado desde el panel de Cloudflare.
VITE_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# --- Scripts de carga (NO se exponen al frontend) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=digesto

# Clave service_role: permite escribir en la tabla saltando RLS.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=
