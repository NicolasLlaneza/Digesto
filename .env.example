# --- Frontend (se embeben en el bundle, solo claves públicas) ---
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# El bucket de R2 es privado: los archivos se sirven con URLs firmadas que
# emite la Edge Function, así que el frontend no necesita su dirección.

# --- Scripts de carga (NO se exponen al frontend) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=digesto

# Clave service_role: permite escribir en la tabla saltando RLS.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# --- Secrets de la Edge Function ---
# No van en este archivo: se cargan en Supabase con
#   supabase secrets set R2_ACCOUNT_ID=... R2_ACCESS_KEY_ID=... \
#                        R2_SECRET_ACCESS_KEY=... R2_BUCKET=digesto \
#                        ORIGEN_PERMITIDO=https://tu-dominio
